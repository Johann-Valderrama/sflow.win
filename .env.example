GROQ_API_KEY=your_groq_api_key_here

# Backend de insights — fallback global (si no se setean los específicos por tarea, se usa este).
# Activa seleccionando el backend en el dashboard o seteando directamente:
# Valores: groq | endpoint (LM Studio local) | openrouter (nube) | anthropic (API oficial) |
#          claude-cli (suscripción Claude vía Claude Code — vivo y batch)
# INSIGHTS_BACKEND=groq

# Backend de insights POR TAREA (opcional). Si no se setean, heredan INSIGHTS_BACKEND; si tampoco, "groq".
# Recomendado con suscripción Claude Max: ambos en claude-cli (vivo=Haiku, acta=Sonnet) — $0 marginal,
# amortiza el plan; la cuota Max absorbe el vivo sin problema. Plan B si topas el límite semanal
# (síntoma: el panel en vivo deja de actualizar): vivo a groq u openrouter (el benchmark dejó
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite como mejor costo-beneficio API).
INSIGHTS_BACKEND_LIVE=
INSIGHTS_BACKEND_BATCH=

# Fallback automático (opcional, default true) — si el backend primario de una tarea falla,
# reintenta UNA vez con groq u openrouter (nunca endpoint/anthropic/claude-cli como destino) y
# abre un circuit breaker para no reintentar un backend roto en cada llamada.
# INSIGHTS_FALLBACK=true
# Segundos que el breaker mantiene abierto un backend primario tras un fallo (default 300).
# INSIGHTS_FALLBACK_COOLDOWN=300

# OpenRouter (opcional) — backend de insights en la nube con acceso a muchos modelos.
# Activa seleccionando "OpenRouter (nube)" en el dashboard (o INSIGHTS_BACKEND_BATCH=openrouter).
# Pega tu key real en .env (NO en .env.example). Consigue una en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo a usar (slug de openrouter.ai/models). Default: google/gemini-3.1-flash-lite
# (acta/Asistente: 1M ctx, Intel 33.5, ~$0.0006/llamada, SIN razonamiento por defecto — medido 2026-06-14).
# Alternativas: google/gemini-3.5-flash (premium, razona por defecto), google/gemini-3-flash-preview (Intel 35).
# Verifica el slug vigente en https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Base URL (no cambiar salvo proxy):
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic (opcional) — backend de insights con la API oficial de Anthropic.
# Activa seleccionando "Anthropic (API oficial)" en el dashboard (o INSIGHTS_BACKEND_BATCH=anthropic).
# Pega tu key real en .env (NO en .env.example). Consigue una en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelos por tarea (IDs exactos, sin sufijo de fecha).
ANTHROPIC_MODEL_LIVE=claude-haiku-4-5
ANTHROPIC_MODEL_BATCH=claude-sonnet-5

# claude-cli (opcional) — usa tu suscripción de Claude vía Claude Code headless (`claude -p`), sin API key.
# Sirve para vivo Y batch. OJO: consume la cuota de tu plan Pro/Max (una reunión larga con
# análisis en vivo gasta decenas de mensajes). Requiere Claude Code instalado y logueado (claude login).
# CLAUDE_CLI_PATH=  # ruta explícita al binario si no está en PATH ni en %APPDATA%\npm
CLAUDE_CLI_MODEL_LIVE=haiku
CLAUDE_CLI_MODEL_BATCH=sonnet

# artificialanalysis.ai

ARTIFICIAL_ANALYSIS_API_KEY=

# Auth local del dashboard. Default true: el dashboard y su API exigen el token local de
# sesión (se genera solo en dashboard_token.txt dentro del directorio de datos). Ábrelo desde
# el icono de la bandeja y el token viaja en el enlace. Solo el valor "false" apaga el guard;
# cualquier otro valor lo deja encendido (fail-closed).
# DASHBOARD_AUTH_ENABLED=true

# Retención opcional de reuniones (unidad 3.2). Default 0 = conservar reuniones (actas y
# transcripts) SIEMPRE. Si se pone > 0, al ARRANCAR la app se borran definitivamente las
# reuniones más viejas que N días (fila + su entrada en el índice de búsqueda). Es la única
# operación destructiva de este flujo: default apagado a propósito.
# MEETING_RETENTION_DAYS=0